# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/feedants_competition)
MONGODB_URI=mongodb://localhost:27017/feedants_competition

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Isolated Test Database URI (used exclusively for automated test suites)
TEST_MONGODB_URI=mongodb://localhost:27017/feedants_test_isolated

