# Backend API Base URL for Feedants Mobile App
# Local development default: http://localhost:5000 (matches backend PORT=5000)
#
# Device-specific connection guides:
# - iOS Simulator:     http://localhost:5000
# - Android Emulator:  http://10.0.2.2:5000
# - Physical Device:   http://<your-machine-lan-ip>:5000 (e.g. http://192.168.1.50:5000)
#
# Note: EXPO_PUBLIC_* variables are client-visible in the JavaScript bundle.
# NEVER store secrets, API keys, or private credentials in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://localhost:5000
